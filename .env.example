# Telegram BotFather 给你的机器人 Token
TELEGRAM_BOT_TOKEN=123456:ABCDEF

# 你的 Telegram 用户数字 ID，只允许这个人控制机器人
# 获取方法：私聊 @userinfobot 或 @RawDataBot
TELEGRAM_OWNER_ID=123456789

# 你的频道 ID 或 @频道用户名
# 例如：@your_channel_username
# 如果是私有频道，一般是 -100xxxxxxxxxx，并且机器人必须是频道管理员
TELEGRAM_CHANNEL_ID=@your_channel_username

# OpenAI API Key
OPENAI_API_KEY=sk-xxxx

# 模型名：按你 OpenAI 控制台里可用模型填写
# 如果报 model not found，就换成你账户可用的模型
OPENAI_MODEL=gpt-4.1-mini

# GitHub Token 可选；不填也能用，但容易触发低频率限制
GITHUB_TOKEN=

# 默认搜索关键词；/find 不带参数时会用它
DEFAULT_SEARCH_KEYWORD=automation self-hosted ai data dashboard telegram bot

# 频道品牌名，会写进文案和图片提示词
CHANNEL_NAME=开源项目变现局

# 是否开启每日自动生成草稿到你的私聊：true/false
# 注意：只发到你私聊审核，不会自动发频道
AUTO_DRAFT_ENABLED=false
AUTO_DRAFT_HOUR=9
AUTO_DRAFT_MINUTE=0
BOT_TIMEZONE=Asia/Shanghai
